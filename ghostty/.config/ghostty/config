# ============================================================================
# Ghostty config — synced with One Dark Darkened theme
# Source: https://github.com/pavles6/one-dark-darkened
# ============================================================================

# ---------------------------------------------------------------------------
# Core editor + terminal surfaces
# ---------------------------------------------------------------------------
background           = #17191d
foreground           = #bfc4cd
selection-background = #2a2f38
selection-foreground = #e5e7ea

# Cursor (matches theme "players[0].cursor")
cursor-color = #74ade8
cursor-text  = #17191d

# ---------------------------------------------------------------------------
# Terminal ANSI palette (matches theme "terminal.ansi.*")
# ---------------------------------------------------------------------------
palette = 0=#282c34
palette = 1=#e06c75
palette = 2=#98c379
palette = 3=#e5c07b
palette = 4=#61afef
palette = 5=#c678dd
palette = 6=#56b6c2
palette = 7=#abb2bf
palette = 8=#636d83
palette = 9=#ea858b
palette = 10=#aad581
palette = 11=#ffd885
palette = 12=#85c1ff
palette = 13=#d398eb
palette = 14=#6ed5de
palette = 15=#fafafa

# ---------------------------------------------------------------------------
# Window decorations
# ---------------------------------------------------------------------------
window-decoration           = false
window-padding-balance      = true
window-padding-color        = extend
macos-titlebar-style        = transparent
macos-window-shadow         = false
macos-non-native-fullscreen = false

# ---------------------------------------------------------------------------
# Font
# ---------------------------------------------------------------------------
font-family    = "JetBrains Mono"
font-size      = 14
font-thicken   = true
font-feature   = -liga, +calt

# ---------------------------------------------------------------------------
# Behavior
# ---------------------------------------------------------------------------
mouse-hide-while-typing    = true
confirm-close-surface     = false
clipboard-read            = allow
clipboard-paste-protection = false
clipboard-write           = allow
shell-integration         = detect
shell-integration-features = cursor,sudo,title

# ---------------------------------------------------------------------------
# Keybinds
# ---------------------------------------------------------------------------
keybind = global:ctrl+grave_accent=toggle_quick_terminal
keybind = global:cmd+grave_accent=toggle_quick_terminal

# ---------------------------------------------------------------------------
# Custom env so other tools can detect we're in a "Darkened" terminal
# ---------------------------------------------------------------------------
env = COLORTERM_DARKENED=1
