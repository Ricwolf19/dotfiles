# ============================================================================
# Ghostty config — One Dark Darkened theme
# Palette matched exactly to the Zed "One Dark - Darkened" extension so the
# terminal reads identically to the editor: soft silver-gray text on a deep
# dark surface, easy on the eyes. Silver accent on the cursor.
# Source: Zed extension one-dark-darkened (themes/one-dark-darkened.json).
# ============================================================================

# ---------------------------------------------------------------------------
# Core surfaces (match Zed: editor.background / terminal.foreground)
# ---------------------------------------------------------------------------
background           = #17191d
foreground           = #c8ccd4
selection-background = #454a56
selection-foreground = #e5e7ea

# Cursor — silver accent (the "toque plateado"), dark glyph underneath.
cursor-color = #c8ccd4
cursor-text  = #17191d

# ---------------------------------------------------------------------------
# Terminal ANSI palette (matches theme terminal.ansi.*)
# ---------------------------------------------------------------------------
palette = 0=#282c34
palette = 1=#e06c75
palette = 2=#98c379
palette = 3=#e5c07b
palette = 4=#61afef
palette = 5=#c678dd
palette = 6=#56b6c2
palette = 7=#abb2bf
palette = 8=#636d83
palette = 9=#ea858b
palette = 10=#aad581
palette = 11=#ffd885
palette = 12=#85c1ff
palette = 13=#d398eb
palette = 14=#6ed5de
palette = 15=#fafafa

# ---------------------------------------------------------------------------
# Window decorations
# ---------------------------------------------------------------------------
window-decoration           = false
window-padding-balance      = true
window-padding-color        = extend
macos-titlebar-style        = transparent
macos-window-shadow         = false
macos-non-native-fullscreen = false

# ---------------------------------------------------------------------------
# Font
# ---------------------------------------------------------------------------
font-family    = "JetBrains Mono"
font-size      = 14
font-thicken   = true
font-feature   = -liga, +calt

# ---------------------------------------------------------------------------
# Cursor trail shaders (GLSL, vendored from sahaj-b/ghostty-cursor-shaders, MIT)
#   cursor_warp        — Neovide-like smooth trail that follows the cursor.
#   sonic_boom_cursor  — expanding pulse on cursor mode change (block <-> line).
# custom-shader-animation = always keeps the trail animating even when the
# window loses focus. Tuning parameters live at the top of each .glsl file.
# ---------------------------------------------------------------------------
custom-shader = shaders/cursor_warp.glsl
custom-shader = shaders/sonic_boom_cursor.glsl
custom-shader-animation = always

# ---------------------------------------------------------------------------
# Behavior
# ---------------------------------------------------------------------------
mouse-hide-while-typing    = true
confirm-close-surface     = false
clipboard-read            = allow
clipboard-paste-protection = false
clipboard-write           = allow
shell-integration         = detect
shell-integration-features = cursor,sudo,title

# ---------------------------------------------------------------------------
# Keybinds
# ---------------------------------------------------------------------------
keybind = global:ctrl+grave_accent=toggle_quick_terminal
keybind = global:cmd+grave_accent=toggle_quick_terminal
