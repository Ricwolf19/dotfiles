#!/bin/bash
# JankyBorders configuration — managed in ~/.dotfiles (GNU Stow).
#
# STATUS: DISABLED (2026-07-05) — parked for later polish. Not launched by
# AeroSpace and not running as a brew service. The config below is kept as-is.
# Re-enable: uncomment the block in aerospace/.aerospace.toml, then
#   brew services start borders
#
# Started by AeroSpace via after-startup-command; can also run as a brew service.
# Update live at any time by re-invoking `borders <options>`.
# Man page: https://github.com/FelixKratz/JankyBorders/wiki/Man-Page

options=(
	style=round
	width=2.0                    # light, subtle border (default 5.0 is heavy)
	hidpi=on                     # crisp rendering on Retina displays
	active_color=0xffc0c0c0      # silver — focused window
	inactive_color=0xff2a2a2a    # near-black gray — unfocused (Vesper-dark)
)

borders "${options[@]}"
